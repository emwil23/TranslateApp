{
  "name": "translateplus",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Translate+: the translator that gets your tone",
  "license": "MIT",
  "author": "Emmanuel Wilson",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "e2e": "playwright test",
    "prepare": "husky"
  },
