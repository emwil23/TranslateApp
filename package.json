    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.13.0",
    "gsap": "^3.15.0",
    "jszip": "^3.10.2",
    "lenis": "^1.3.27",
    "lucide-react": "^1.59.0",
    "mammoth": "^1.13.0",
    "motion": "^14.3.0",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "react": "19.3",
    "react-dom": "19.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
