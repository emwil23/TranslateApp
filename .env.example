# All optional. With none set, Pixe still works offline with boards you made, and offers Puter, OpenRouter or your own key for AI.
# The shared backend (ew-apps-api). Unset = no photo search and no "Pixe AI (free)" option.
VITE_API_URL=http://localhost:8787
# Supabase project used for sign-in to the AI server.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to 1 once the Google provider is enabled in Supabase, to show "Continue with Google".
VITE_GOOGLE_SIGNIN=
